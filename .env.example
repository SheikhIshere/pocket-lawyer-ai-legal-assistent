# Copy to .env and fill in real values.
# Database
DB_HOST=db
DB_NAME=pocket_lawyer
DB_USER=pocket_user
DB_PASS=change-me
DB_PORT=5432

# Django
SECRET_KEY=change-me
DEBUG=True

# AI Services
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Generate with:
# python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DJANGO_CRYPTO_KEY=your-fernet-key

# Platform AI fallback (OmniRoute OpenAI-compatible endpoint)
OMNIROUTE_BASE_URL=http://your-omniroute-host:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_MODEL=ddgw/tinfoil/gpt-oss-120b
OMNIROUTE_FALLBACK_MODELS=ddgw/gpt-5.6-luna,ddgw/tinfoil/gemma4-31b,ddgw/claude-haiku-4-5
OMNIROUTE_DAILY_LIMIT=50

# Legal RAG
LEGAL_RAG_TOP_K=5
LEGAL_RAG_MIN_SCORE=0.60
LEGAL_RAG_EMBEDDING_PROVIDER=ollama
LEGAL_RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
LEGAL_RAG_EMBEDDING_DIM=1024
OLLAMA_BASE_URL=http://host.docker.internal:11435

# Message Queue
CELERY_BROKER_URL=amqp://pocketlawyer:change-me@mq:5672//
RABBITMQ_DEFAULT_USER=pocketlawyer
RABBITMQ_DEFAULT_PASS=change-me

# Email (Resend SMTP)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=your-resend-api-key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
